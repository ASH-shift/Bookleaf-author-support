# Copy this file to server/.env and fill in values. Never commit server/.env.

NODE_ENV=development
PORT=4000

# Long random string used to sign session tokens. REQUIRED in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Groq API key (server-side only, never exposed to the browser). Free key: https://console.groq.com/keys
# If empty, the app still works: tickets are classified with keyword rules and
# admins write responses manually.
GROQ_API_KEY=

# Models (override if you want a different cost/quality trade-off).
AI_CLASSIFIER_MODEL=openai/gpt-oss-20b
AI_DRAFT_MODEL=openai/gpt-oss-120b
AI_TIMEOUT_MS=20000

# SQLite database file (relative to server/). Re-seeded automatically when empty.
DATABASE_PATH=./data/bookleaf.db

# Demo passwords used ONLY by the seed script. Change these for any shared deployment.
SEED_AUTHOR_PASSWORD=Author@123
SEED_ADMIN_PASSWORD=Admin@123

